# 环境变量（含真实密钥，切勿提交）
.env
.env.*
!.env.example
!backend/.env.production.example
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# 向量库 / 本地运行时数据（含密钥与测试会话，不入库）
backend/data/

# 测试生成的论文输出
backend/scripts/testset/output_2023C.md

# 前端构建产物 / 依赖
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# 运行日志 / 临时输出 / Agent 运行产物
*.log
_ws_out*.txt
backend/images/
backend/output_paper.*
backend/paper_output/

# Agent / 编辑器工作数据（不入库）
.codebuddy/
.idea/
.vscode/

# 系统杂项
.DS_Store
Thumbs.db
.env.local

# DSH 插件源码（非本项目代码，本地开发用）
_plugins/

# 根目录误装残留（依赖统一由 frontend/package.json 管理）
/node_modules/
/package.json
/package-lock.json

# Morning Star harness（进程本地；审计计划与知识为共享结果，显式放行）
.mstar/**
!.mstar/AGENTS.md
!.mstar/knowledge/
!.mstar/knowledge/**
!.mstar/specs/
!.mstar/specs/**
!.mstar/plans/
!.mstar/plans/**

# 一次性调试脚本 / 错误转储
backend/_err.txt
backend/_start.bat

# pnpm store 残留
.pnpm-store/

# firecrawl CLI 本地缓存（搜索结果原始数据）
.firecrawl/


# ��Ŀ���⻷��
.venv/

# 项目级工具目录（仅根目录，勿用裸 tools/——那会连带忽略 backend/app/tools/ 的新文件）
/tools/

!.env.production.example
