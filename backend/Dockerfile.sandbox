# MathModelAgent 代码沙箱镜像
# 预装科学计算库 + OCR（tesseract 中英文 + poppler），
# 通过 docker run --rm --network=none --memory=512m 隔离执行
FROM python:3.11-slim

# ── 系统依赖 ──
# tesseract-ocr：OCR 引擎（扫描版 PDF/图片提取文字）
# tesseract-ocr-chi-sim / chi-tra / eng：简中 / 繁中 / 英文语言包
# poppler-utils：pdftoppm / pdfimages（把扫描 PDF 每页转成 PNG 供 OCR）
# fonts-noto-cjk：中文字体（matplotlib 图表中文渲染，缺了会变豆腐块）
RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr \
        tesseract-ocr-chi-sim \
        tesseract-ocr-chi-tra \
        tesseract-ocr-eng \
        poppler-utils \
        fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# ── Python 依赖 ──
# pytesseract：tesseract 的 Python 绑定
# pdf2image：调用 poppler 把 PDF 转图片
# pillow：图像处理（matplotlib 已依赖，显式声明保险）
# pymupdf：PDF 渲染转图（fitz，rapidocr 路线用）
# rapidocr_onnxruntime：纯 Python 中英文 OCR（RunCodeTool 描述宣称可用，需与镜像一致）
RUN pip install --no-cache-dir \
    numpy \
    scipy \
    pandas \
    matplotlib \
    seaborn \
    networkx \
    pyarrow \
    sympy \
    cvxpy \
    openpyxl \
    xlsxwriter \
    pytesseract \
    pdf2image \
    pillow \
    pymupdf \
    rapidocr_onnxruntime

COPY sandbox_wrapper.py /wrapper.py

ENTRYPOINT ["python", "/wrapper.py"]
