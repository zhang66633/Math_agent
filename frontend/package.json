{
  "name": "math-model-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=512 node_modules/vite/bin/vite.js",
    "build": "node scripts/markdown_pipeline_smoke.mjs && vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:markdown": "node scripts/markdown_pipeline_smoke.mjs"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/vue-virtual": "^3.13.35",
    "@vueuse/core": "^12.7.0",
    "axios": "^1.8.4",
    "dompurify": "^3.4.12",
    "driver.js": "^1.8.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "lucide-vue-next": "^0.475.0",
    "marked": "^15.0.11",
    "marked-katex-extension": "^5.1.4",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.5.0",
    "reka-ui": "^2.0.0",
    "vue": "^3.5.13",
    "vue-router": "4"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/dompurify": "^3.2.0",
    "@types/highlight.js": "^10.1.0",
    "@types/katex": "^0.16.7",
    "@types/marked": "^6.0.0",
    "@types/node": "^22.13.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.6.0",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.2",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "pnpm@10.6.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome",
      "vue-demi"
    ]
  }
}
